# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: bootstrap admin account. On first sign-in/registration with
# this email, the server automatically grants the ADMIN role (see
# /api/auth/me and /api/auth/register in server.ts). Defaults to
# parkinky@gmail.com if unset - override this if that should be a different
# address. This is the ONLY admin bootstrap mechanism now; there are no
# hardcoded admin passwords or security answers anywhere in the source.
ADMIN_EMAIL="parkinky@gmail.com"

# Firebase Admin SDK credentials (used by every /api/auth/* and /api/admin/*
# route to read/write the `users` collection - Firestore rules deny all
# direct client access to it, see firestore.rules).
# - On Cloud Run / GCE / Cloud Functions: no configuration needed here. The
#   Admin SDK automatically uses the service's own service account, as long
#   as that service account has the "Cloud Datastore User" (or
#   "Firebase Admin") IAM role on this project.
# - For local development: run `gcloud auth application-default login` once,
#   or set GOOGLE_APPLICATION_CREDENTIALS below to a service account key file
#   (Firebase Console > Project Settings > Service Accounts > Generate new
#   private key). Never commit that key file - keep it out of git entirely.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/serviceAccountKey.json"

