rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events collection: allow public read, event creation/updates, and admin deletions
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Community experiences and photos by event
    match /event_experiences/{expId} {
      allow read, write: if true;
    }

    // User profile documents.
    // SECURITY: these documents hold password hashes, security-question answer
    // hashes, phone numbers and role flags. Direct client access is fully
    // denied here on purpose - ALL reads and writes go through the trusted
    // server (server.ts) using the Firebase Admin SDK, which authenticates
    // via GOOGLE_APPLICATION_CREDENTIALS / Cloud Run's service account and
    // therefore bypasses these rules entirely. That server enforces password
    // hashing, security-question verification and admin-only role changes
    // before ever touching this collection. See /api/auth/* and
    // /api/admin/* in server.ts. Do NOT relax this to `if true` again -
    // that previously let anyone on the internet read every user's email,
    // phone number and (plaintext, pre-fix) password directly via the
    // Firestore SDK/REST API, and let anyone promote themselves to ADMIN.
    match /users/{userId} {
      allow read, write: if false;
    }

    // NOTE: removed the previous catch-all
    //   match /{document=**} { allow read, write: if true; }
    // That fallback made every OTHER collection in this Firestore project
    // (including ones you might add later, and any name a bot happens to
    // guess) fully world-readable AND world-writable with no auth check at
    // all. It isn't needed for any collection this app actually uses
    // (events / event_experiences / users are all already covered above),
    // and it's a direct cost + abuse risk: anyone on the internet can point
    // a script at your project and rack up unlimited reads/writes on any
    // collection name, with nothing in these rules to stop them.
    //
    // Default-deny everything not explicitly matched above:
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
